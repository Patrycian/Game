<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controlador.CargarPartidaController"
           stylesheets="@estilos.css"
           styleClass="root-pane">

    <Pane fx:id="panelParticulas" mouseTransparent="true"/>

    <VBox alignment="CENTER" spacing="20">
        <padding><Insets top="30" right="60" bottom="30" left="60"/></padding>

        <Rectangle styleClass="linea-decorativa" width="560" height="1"/>
        <Label styleClass="titulo-pantalla" text="📜  CARGAR PARTIDA"/>
        <Label styleClass="subtitulo" text="✦  Elige una aventura guardada para continuar  ✦"/>
        <Rectangle styleClass="linea-decorativa" width="560" height="1"/>

        <Region prefHeight="8"/>

        <Label fx:id="lblEstado" styleClass="label-error"
               text="" visible="false"/>

        <ScrollPane fitToWidth="true" prefHeight="360" maxWidth="600"
                    styleClass="scroll-ranking">
            <VBox fx:id="contenedorPartidas" spacing="10" alignment="TOP_CENTER">
                <padding><Insets top="4" right="0" bottom="4" left="0"/></padding>
            </VBox>
        </ScrollPane>

        <Region prefHeight="8"/>

        <Button styleClass="btn-menu-secundario"
                text="←  VOLVER AL MENÚ"
                prefWidth="220" prefHeight="42"
                onAction="#handleVolver"/>
    </VBox>

</StackPane>

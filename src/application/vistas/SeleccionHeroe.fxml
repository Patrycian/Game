<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controlador.SeleccionHeroeController"
           stylesheets="@estilos.css"
           styleClass="root-pane">

    <Pane fx:id="panelParticulas" mouseTransparent="true"/>

    <VBox alignment="CENTER" spacing="20">
        <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

        <Rectangle styleClass="linea-decorativa" width="620" height="1"/>
        <Label styleClass="titulo-pantalla" text="⚔  ELIGE TU CLASE  ⚔"/>
        <Label fx:id="lblSaludo" styleClass="subtitulo" text="✦  Aventurero, forja tu leyenda  ✦"/>
        <Rectangle styleClass="linea-decorativa" width="620" height="1"/>
        <Region prefHeight="6"/>

        <HBox alignment="CENTER" spacing="24">

            <!-- MAGO -->
            <VBox fx:id="cardMago" styleClass="card-robot" alignment="CENTER"
                  spacing="12" prefWidth="220" minHeight="310"
                  onMouseClicked="#handleSeleccionarMago">
                <padding><Insets top="22" right="18" bottom="22" left="18"/></padding>
                <Label styleClass="card-icono" text="🧙"/>
                <Label styleClass="card-nombre" text="MAGO"/>
                <Label styleClass="card-descripcion" wrapText="true" textAlignment="CENTER"
                       text="Domina las artes arcanas. Alto poder mágico pero frágil en combate cuerpo a cuerpo."/>
                <Rectangle styleClass="card-separador" width="150" height="1"/>
                <VBox spacing="6" alignment="CENTER">
                    <Label styleClass="card-habilidad" text="⚡  Stats"/>
                    <Label styleClass="card-habilidad-desc" text="HP: 80  DEF: 5  POD: 25"/>
                    <Label styleClass="card-habilidad" text="🔥  Bola de Fuego"/>
                    <Label styleClass="card-habilidad-desc" wrapText="true" textAlignment="CENTER"
                           text="Daño mágico doble directo (ignora la defensa enemiga)"/>
                </VBox>
            </VBox>

            <!-- GUERRERO -->
            <VBox fx:id="cardGuerrero" styleClass="card-robot" alignment="CENTER"
                  spacing="12" prefWidth="220" minHeight="310"
                  onMouseClicked="#handleSeleccionarGuerrero">
                <padding><Insets top="22" right="18" bottom="22" left="18"/></padding>
                <Label styleClass="card-icono" text="⚔️"/>
                <Label styleClass="card-nombre" text="GUERRERO"/>
                <Label styleClass="card-descripcion" wrapText="true" textAlignment="CENTER"
                       text="Equilibrado y resistente. Domina el combate cuerpo a cuerpo con fuerza bruta."/>
                <Rectangle styleClass="card-separador" width="150" height="1"/>
                <VBox spacing="6" alignment="CENTER">
                    <Label styleClass="card-habilidad" text="⚡  Stats"/>
                    <Label styleClass="card-habilidad-desc" text="HP: 120  DEF: 15  POD: 18"/>
                    <Label styleClass="card-habilidad" text="⚔️  Golpe Devastador"/>
                    <Label styleClass="card-habilidad-desc" wrapText="true" textAlignment="CENTER"
                           text="Ataque brutal que inflige ×1,5 tu poder descontando la defensa enemiga"/>
                </VBox>
            </VBox>

            <!-- CLÉRIGO -->
            <VBox fx:id="cardClerigo" styleClass="card-robot" alignment="CENTER"
                  spacing="12" prefWidth="220" minHeight="310"
                  onMouseClicked="#handleSeleccionarClerigo">
                <padding><Insets top="22" right="18" bottom="22" left="18"/></padding>
                <Label styleClass="card-icono" text="✝️"/>
                <Label styleClass="card-nombre" text="CLÉRIGO"/>
                <Label styleClass="card-descripcion" wrapText="true" textAlignment="CENTER"
                       text="Soporte divino. Aguante moderado y la capacidad de curarse en el momento clave."/>
                <Rectangle styleClass="card-separador" width="150" height="1"/>
                <VBox spacing="6" alignment="CENTER">
                    <Label styleClass="card-habilidad" text="⚡  Stats"/>
                    <Label styleClass="card-habilidad-desc" text="HP: 100  DEF: 12  POD: 14"/>
                    <Label styleClass="card-habilidad" text="✨  Curación Divina"/>
                    <Label styleClass="card-habilidad-desc" wrapText="true" textAlignment="CENTER"
                           text="Recupera el 40 % de tu vida máxima en un turno crítico"/>
                </VBox>
            </VBox>

        </HBox>

        <Label fx:id="lblSeleccionado" styleClass="label-seleccionado"
               text="" visible="false" managed="false"/>

        <Region prefHeight="6"/>

        <HBox alignment="CENTER" spacing="20">
            <Button styleClass="btn-menu-secundario"
                    text="←  VOLVER"
                    prefWidth="180" prefHeight="40"
                    onAction="#handleVolver"/>
            <Button fx:id="btnAventura"
                    styleClass="btn-menu"
                    text="⚔  ¡ENTRAR A LA MAZMORRA!"
                    prefWidth="260" prefHeight="46"
                    disable="true"
                    onAction="#handleAventura"/>
        </HBox>

    </VBox>
</StackPane>

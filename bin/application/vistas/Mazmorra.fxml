<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controlador.MazmorraController"
           stylesheets="@estilos.css"
           styleClass="root-pane"
           style="-fx-background-color: transparent;">

    <!-- Fondo de la pantalla de combate -->
    <ImageView fitWidth="900" fitHeight="650" preserveRatio="false"
               StackPane.alignment="CENTER" mouseTransparent="true">
        <image><Image url="@../../recursos/imagen/fondo.png"/></image>
    </ImageView>

    <VBox spacing="0">

        <HBox styleClass="hud-barra" alignment="CENTER" prefHeight="42">
            <padding><Insets top="0" right="20" bottom="0" left="20"/></padding>
            <Label fx:id="lblFase" styleClass="hud-valor"
                   text="FASE 1"/>
        </HBox>

        <StackPane styleClass="escena-batalla" VBox.vgrow="ALWAYS" prefHeight="360">

            <VBox spacing="0">

                <HBox alignment="CENTER" spacing="10" prefHeight="170">
                    <padding><Insets top="20" right="40" bottom="0" left="40"/></padding>

                    <VBox styleClass="caja-info-pokemon" spacing="6" prefWidth="290" maxWidth="290">
                        <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="lblNombreEnemigo" styleClass="info-pokemon-nombre"
                                   text="Enemigo"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label styleClass="info-pokemon-hp-label" text="HP"/>
                            <ProgressBar fx:id="barraVidaEnemigo" prefWidth="200" prefHeight="10"
                                         progress="1.0" styleClass="barra-vida-pokemon"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblHpEnemigo" styleClass="info-pokemon-hp-num"
                                   text="-/- HP"/>
                        </HBox>
                        <!-- Barra de PM: solo visible para enemigos mágicos (Saga, Dragón) -->
                        <HBox fx:id="filaPmEnemigo" alignment="CENTER_LEFT" spacing="8"
                              visible="false" managed="false">
                            <Label styleClass="info-pokemon-pm-label" text="PM"/>
                            <ProgressBar fx:id="barraPmEnemigo" prefWidth="200" prefHeight="10"
                                         progress="1.0" styleClass="barra-pm-pokemon"/>
                        </HBox>
                        <HBox fx:id="filaNumPmEnemigo" alignment="CENTER_RIGHT"
                              visible="false" managed="false">
                            <Label fx:id="lblPmEnemigo" styleClass="info-pokemon-hp-num"
                                   text="-/- PM"/>
                        </HBox>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <StackPane prefWidth="160" prefHeight="160" styleClass="plataforma-enemigo">
                        <ImageView fx:id="imgEnemigo" fitWidth="120" fitHeight="120"
                                   preserveRatio="true" StackPane.alignment="CENTER"/>
                    </StackPane>
                </HBox>

                <HBox alignment="CENTER" spacing="10" prefHeight="170">
                    <padding><Insets top="100" right="40" bottom="10" left="40"/></padding>
                    
                    <!-- RECORDAR: Modificar top/bottom -->

                    <StackPane prefWidth="160" prefHeight="160" styleClass="plataforma-heroe">
                        <ImageView fx:id="imgHeroe" fitWidth="120" fitHeight="120"
                                   preserveRatio="true" StackPane.alignment="CENTER"/>
                    </StackPane>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox styleClass="caja-info-pokemon" spacing="6" prefWidth="320" maxWidth="320">
                        <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="lblNombreHeroe" styleClass="info-pokemon-nombre"
                                   text="Heroe"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label styleClass="info-pokemon-hp-label" text="HP"/>
                            <ProgressBar fx:id="barraVidaHeroe" prefWidth="200" prefHeight="10"
                                         progress="1.0" styleClass="barra-vida-pokemon"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblHpHeroe" styleClass="info-pokemon-hp-num"
                                   text="-/- HP"/>
                        </HBox>
                        <!-- Barra de PM: solo visible en personajes mágicos -->
                        <HBox fx:id="filaPm" alignment="CENTER_LEFT" spacing="8"
                              visible="false" managed="false">
                            <Label styleClass="info-pokemon-pm-label" text="PM"/>
                            <ProgressBar fx:id="barraPoderMagico" prefWidth="200" prefHeight="10"
                                         progress="1.0" styleClass="barra-pm-pokemon"/>
                        </HBox>
                        <HBox fx:id="filaNumPm" alignment="CENTER_RIGHT"
                              visible="false" managed="false">
                            <Label fx:id="lblPmHeroe" styleClass="info-pokemon-hp-num"
                                   text="-/- PM"/>
                        </HBox>
                    </VBox>
                </HBox>

            </VBox>

            <Label fx:id="lblResultado" styleClass="overlay-titulo-oro"
                   text="" visible="false" alignment="CENTER"
                   StackPane.alignment="CENTER"/>

        </StackPane>

        <HBox styleClass="caja-dialogo-batalla" spacing="0" prefHeight="180" minHeight="180">

            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <padding><Insets top="14" right="14" bottom="14" left="20"/></padding>

                <Label fx:id="lblPrompt" styleClass="dialogo-prompt"
                       text="Acción:" wrapText="true"/>

                <TextArea fx:id="txtLog"
                          styleClass="log-combate-pokemon"
                          editable="false"
                          wrapText="true"
                          VBox.vgrow="ALWAYS"/>

                <Button fx:id="btnContinuar"
                        styleClass="btn-menu"
                        text="Siguiente Fase"
                        prefHeight="36"
                        visible="false"
                        managed="false"
                        onAction="#handleContinuar"
                        alignment="CENTER"/>
            </VBox>

            <Rectangle styleClass="separador-arena" width="2" height="180"/>

            <!-- Panel derecho: menú principal-->
            <!-- Cambiamos el ancho de los tres paneles porque son hijos del mismo StackPane -->
            <StackPane prefWidth="300" minWidth="280">

                <!-- Menú principal de batalla -->
                <VBox fx:id="menuBatalla" spacing="6" alignment="CENTER">
                    <padding><Insets top="10" right="16" bottom="10" left="14"/></padding>

                    <Button fx:id="btnAtacar"
                            styleClass="btn-batalla-barra"
                            text="ATAQUE"
                            onAction="#handleAtacar"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"
                            VBox.vgrow="ALWAYS"/>
                    <Button fx:id="btnObjetos"
                            styleClass="btn-batalla-barra"
                            text="OBJETOS"
                            onAction="#handleObjetos"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"
                            VBox.vgrow="ALWAYS"/>
                    <Button fx:id="btnHabilidad"
                            styleClass="btn-batalla-barra"
                            text="HABILIDAD"
                            onAction="#handleHabilidad"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"
                            VBox.vgrow="ALWAYS"/>
                    <Button fx:id="btnMagia"
                            styleClass="btn-batalla-barra"
                            text="✨ MAGIA"
                            onAction="#handleMagia"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"
                            VBox.vgrow="ALWAYS"
                            visible="false" managed="false"/>
                    <Button fx:id="btnHabilidades"
                            styleClass="btn-batalla-barra"
                            text="⚔️ HABILIDADES"
                            onAction="#handleHabilidades"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"
                            VBox.vgrow="ALWAYS"
                            visible="false" managed="false"/>
                    <Button fx:id="btnHuir"
                            styleClass="btn-batalla-barra-huir"
                            text="HUIDA"
                            onAction="#handleHuir"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"
                            VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- Submenú de magia (inicialmente oculto) -->
                <VBox fx:id="menuMagia" spacing="6" alignment="CENTER"
                      visible="false" managed="false">
                    <padding><Insets top="10" right="16" bottom="10" left="14"/></padding>

                    <Label text="✨  MAGIA" styleClass="dialogo-prompt"/>

                    <!-- Botones de habilidades mágicas añadidos dinámicamente -->
                    <VBox fx:id="contenedorHabilidades" spacing="6" VBox.vgrow="ALWAYS"/>

                    <Button styleClass="btn-batalla-barra-huir"
                            text="← Volver"
                            onAction="#handleVolverMenu"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"/>
                </VBox>

                <!-- Submenú de objetos (inicialmente oculto) -->
                <VBox fx:id="menuObjetos" spacing="6" alignment="CENTER"
                      visible="false" managed="false">
                    <padding><Insets top="10" right="16" bottom="10" left="14"/></padding>

                    <Label text="🎒  OBJETOS" styleClass="dialogo-prompt"/>

                    <Button fx:id="btnPocionCuracion"
                            styleClass="btn-batalla-barra"
                            text="🧪 POCIÓN DE CURACIÓN"
                            onAction="#handleUsarPocionCuracion"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"
                            VBox.vgrow="ALWAYS"/>
                    <Button fx:id="btnPocionMagica"
                            styleClass="btn-batalla-barra"
                            text="🔮 POCIÓN MÁGICA"
                            onAction="#handleUsarPocionMagica"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"
                            VBox.vgrow="ALWAYS"/>

                    <Button styleClass="btn-batalla-barra-huir"
                            text="← Volver"
                            onAction="#handleVolverMenuObjetos"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"/>
                </VBox>

                <!-- Submenú de habilidades del guerrero (inicialmente oculto) -->
                <VBox fx:id="menuHabilidades" spacing="6" alignment="CENTER"
                      visible="false" managed="false">
                    <padding><Insets top="10" right="16" bottom="10" left="14"/></padding>

                    <Label text="⚔️  HABILIDADES" styleClass="dialogo-prompt"/>

                    <!-- Botones de habilidades añadidos dinámicamente -->
                    <VBox fx:id="contenedorHabilidadesGuerrero" spacing="6" VBox.vgrow="ALWAYS"/>

                    <Button styleClass="btn-batalla-barra-huir"
                            text="← Volver"
                            onAction="#handleVolverMenuHabilidades"
                            maxWidth="Infinity" prefHeight="36" minHeight="32"/>
                </VBox>

            </StackPane>
        </HBox>

    </VBox>

    <!-- ══════════════════════════════════════════════════════════════════════
         Pantalla de carga entre fases (overlay opaco, oculta por defecto).
         Es el último hijo del StackPane raíz para renderizarse sobre todo.
         ══════════════════════════════════════════════════════════════════════ -->
    <StackPane fx:id="pantallaEntrefase"
               visible="false" managed="false"
               prefWidth="900" prefHeight="650"
               style="-fx-background-color: rgba(10,10,15,0.97);">

        <!-- Partículas doradas (añadidas dinámicamente desde el controlador) -->
        <Pane fx:id="panelParticulasCarga"
              prefWidth="900" prefHeight="650"
              mouseTransparent="true"/>

        <!-- Contenido central -->
        <VBox alignment="CENTER" spacing="18">
            <padding><Insets top="0" right="80" bottom="0" left="80"/></padding>

            <!-- Línea decorativa superior -->
            <Rectangle width="240" height="1" fill="rgba(200,168,75,0.45)"/>

            <!-- Icono de fase -->
            <Label fx:id="lblCargaIcono" text="⚔"
                   style="-fx-font-size: 72px;
                          -fx-effect: dropshadow(gaussian, rgba(200,168,75,0.65), 30, 0, 0, 0);"/>

            <!-- Número de fase -->
            <Label fx:id="lblCargaFase" text="FASE 2" styleClass="titulo"/>

            <!-- Subtítulo MAZMORRA / JEFE FINAL -->
            <Label fx:id="lblCargaSubtitulo" text="— MAZMORRA —"
                   style="-fx-font-family: Georgia; -fx-font-size: 17px;
                          -fx-font-style: italic; -fx-text-fill: #c8a84b;"/>

            <!-- Línea decorativa inferior -->
            <Rectangle width="240" height="1" fill="rgba(200,168,75,0.45)"/>

            <!-- Consejo / frase temática de la fase -->
            <Label fx:id="lblCargaConsejo" wrapText="true" maxWidth="500"
                   textAlignment="CENTER"
                   style="-fx-font-family: Georgia; -fx-font-size: 13px;
                          -fx-font-style: italic; -fx-text-fill: #8a7a60;"/>

            <Region prefHeight="10"/>

            <!-- Barra de progreso animada -->
            <ProgressBar fx:id="barCarga" prefWidth="320" prefHeight="10"
                         progress="0.0"
                         style="-fx-accent: #c8a84b;"/>

            <Label text="Cargando..."
                   style="-fx-font-family: Georgia; -fx-font-size: 11px;
                          -fx-text-fill: rgba(138,122,96,0.65);"/>
        </VBox>

    </StackPane>

    <!-- ══════════════════════════════════════════════════════════════════════
         Diálogo de huida en juego (overlay semiopaco, oculto por defecto).
         Se muestra al pulsar HUIR; los botones Confirmar/Cancelar lo cierran.
         ══════════════════════════════════════════════════════════════════════ -->
    <StackPane fx:id="overlayHuida"
               visible="false" managed="false"
               prefWidth="900" prefHeight="650"
               style="-fx-background-color: rgba(10,10,15,0.85);">

        <!-- Panel central del diálogo -->
        <VBox alignment="TOP_CENTER" spacing="0" maxWidth="480"
              style="-fx-background-color: linear-gradient(to bottom, #14141f, #0d0d16);
                     -fx-border-color: #c8a84b; -fx-border-width: 2;
                     -fx-border-radius: 6; -fx-background-radius: 6;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.85), 35, 0, 0, 0);">

            <!-- Cabecera con tinte dorado -->
            <HBox alignment="CENTER"
                  style="-fx-background-color: rgba(200,168,75,0.10);
                         -fx-padding: 14 24; -fx-background-radius: 4 4 0 0;">
                <Label text="🏃  INTENTANDO HUIR"
                       styleClass="titulo-pantalla"/>
            </HBox>

            <!-- Separador dorado bajo cabecera -->
            <HBox prefHeight="1" style="-fx-background-color: rgba(200,168,75,0.55);"/>

            <!-- Desglose de modificadores -->
            <VBox spacing="6" style="-fx-padding: 16 26 14 26;">
                <Label fx:id="lblHuidaBase"
                       style="-fx-font-family: Georgia; -fx-font-size: 13px;
                              -fx-text-fill: #8a7a60;"/>
                <Label fx:id="lblHuidaVida"
                       style="-fx-font-family: Georgia; -fx-font-size: 13px;
                              -fx-text-fill: #e8e0d0;"/>
                <Label fx:id="lblHuidaClase"
                       style="-fx-font-family: Georgia; -fx-font-size: 13px;
                              -fx-text-fill: #e8e0d0;"
                       visible="false" managed="false"/>
                <Label fx:id="lblHuidaEnemigo"
                       style="-fx-font-family: Georgia; -fx-font-size: 13px;
                              -fx-text-fill: #e8e0d0;"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Separador oscuro -->
            <HBox prefHeight="1" style="-fx-background-color: #2e2840;"/>

            <!-- Probabilidad final destacada -->
            <HBox alignment="CENTER" style="-fx-padding: 14 24;">
                <Label fx:id="lblHuidaProbFinal"
                       style="-fx-font-family: Georgia; -fx-font-size: 21px;
                              -fx-font-weight: bold; -fx-text-fill: #f0d070;
                              -fx-effect: dropshadow(gaussian, rgba(240,208,112,0.5), 12, 0, 0, 0);"/>
            </HBox>

            <!-- Aviso de penalización -->
            <HBox alignment="CENTER" style="-fx-padding: 0 24 14 24;">
                <Label text="⚠  Si fallas, el enemigo atacará como penalización."
                       wrapText="true" textAlignment="CENTER"
                       style="-fx-font-family: Georgia; -fx-font-size: 12px;
                              -fx-font-style: italic; -fx-text-fill: #e05555;"/>
            </HBox>

            <!-- Separador dorado sobre botones -->
            <HBox prefHeight="1" style="-fx-background-color: rgba(200,168,75,0.35);"/>

            <!-- Botones de acción -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 16 24;">
                <Button fx:id="btnConfirmarHuida"
                        text="✅  Intentar huir"
                        onAction="#handleConfirmarHuida"
                        styleClass="btn-batalla-pokemon"
                        prefWidth="190" prefHeight="40"/>
                <Button fx:id="btnCancelarHuida"
                        text="❌  Cancelar"
                        onAction="#handleCancelarHuida"
                        styleClass="btn-batalla-pokemon-huir"
                        prefWidth="190" prefHeight="40"/>
            </HBox>

        </VBox>
    </StackPane>

</StackPane>

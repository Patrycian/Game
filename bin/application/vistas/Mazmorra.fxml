<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controlador.MazmorraController"
           stylesheets="@estilos.css"
           styleClass="root-pane">

    <VBox spacing="0">

        <HBox styleClass="hud-barra" alignment="CENTER" prefHeight="42">
            <padding><Insets top="0" right="20" bottom="0" left="20"/></padding>
            <Label fx:id="lblFase" styleClass="hud-valor"
                   text="FASE 1 - MAZMORRA"/>
        </HBox>

        <StackPane styleClass="escena-batalla" VBox.vgrow="ALWAYS" prefHeight="360">

            <VBox spacing="0">

                <HBox alignment="CENTER" spacing="10" prefHeight="170">
                    <padding><Insets top="20" right="40" bottom="0" left="40"/></padding>

                    <VBox styleClass="caja-info-pokemon" spacing="6" prefWidth="290" maxWidth="290">
                        <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="lblNombreEnemigo" styleClass="info-pokemon-nombre"
                                   text="Enemigo"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label styleClass="info-pokemon-hp-label" text="HP"/>
                            <ProgressBar fx:id="barraVidaEnemigo" prefWidth="200" prefHeight="10"
                                         progress="1.0" styleClass="barra-vida-pokemon"/>
                        </HBox>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <StackPane prefWidth="160" prefHeight="160" styleClass="plataforma-enemigo">
                        <Label fx:id="lblIconoEnemigo" styleClass="sprite-combatiente" text="ENEMY"/>
                    </StackPane>
                </HBox>

                <HBox alignment="CENTER" spacing="10" prefHeight="170">
                    <padding><Insets top="0" right="40" bottom="20" left="40"/></padding>

                    <StackPane prefWidth="160" prefHeight="160" styleClass="plataforma-heroe">
                        <Label fx:id="lblIconoHeroe" styleClass="sprite-combatiente" text="HERO"/>
                    </StackPane>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox styleClass="caja-info-pokemon" spacing="6" prefWidth="320" maxWidth="320">
                        <padding><Insets top="10" right="14" bottom="10" left="14"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="lblNombreHeroe" styleClass="info-pokemon-nombre"
                                   text="Heroe"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label styleClass="info-pokemon-hp-label" text="HP"/>
                            <ProgressBar fx:id="barraVidaHeroe" prefWidth="200" prefHeight="10"
                                         progress="1.0" styleClass="barra-vida-pokemon"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblHpHeroe" styleClass="info-pokemon-hp-num"
                                   text="-/- HP"/>
                        </HBox>
                    </VBox>
                </HBox>

            </VBox>

            <Label fx:id="lblResultado" styleClass="overlay-titulo-oro"
                   text="" visible="false" alignment="CENTER"
                   StackPane.alignment="CENTER"/>

        </StackPane>

        <HBox styleClass="caja-dialogo-batalla" spacing="0" prefHeight="180" minHeight="180">

            <VBox HBox.hgrow="ALWAYS" spacing="6">
                <padding><Insets top="14" right="14" bottom="14" left="20"/></padding>

                <Label fx:id="lblPrompt" styleClass="dialogo-prompt"
                       text="Que hara el heroe?" wrapText="true"/>

                <TextArea fx:id="txtLog"
                          styleClass="log-combate-pokemon"
                          editable="false"
                          wrapText="true"
                          VBox.vgrow="ALWAYS"/>

                <Button fx:id="btnContinuar"
                        styleClass="btn-menu"
                        text="Siguiente Fase"
                        prefHeight="36"
                        visible="false"
                        managed="false"
                        onAction="#handleContinuar"
                        alignment="CENTER"/>
            </VBox>

            <Rectangle styleClass="separador-arena" width="2" height="180"/>

            <VBox fx:id="menuBatalla" spacing="6" alignment="CENTER" prefWidth="240" minWidth="220">
                <padding><Insets top="10" right="16" bottom="10" left="14"/></padding>

                <Button fx:id="btnAtacar"
                        styleClass="btn-batalla-barra"
                        text="ATAQUE"
                        onAction="#handleAtacar"
                        maxWidth="Infinity" prefHeight="36" minHeight="32"
                        VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnObjetos"
                        styleClass="btn-batalla-barra"
                        text="OBJETOS"
                        onAction="#handleObjetos"
                        maxWidth="Infinity" prefHeight="36" minHeight="32"
                        VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnHabilidad"
                        styleClass="btn-batalla-barra"
                        text="HABILIDAD"
                        onAction="#handleHabilidad"
                        maxWidth="Infinity" prefHeight="36" minHeight="32"
                        VBox.vgrow="ALWAYS"/>
                <Button fx:id="btnHuir"
                        styleClass="btn-batalla-barra-huir"
                        text="HUIDA"
                        onAction="#handleHuir"
                        maxWidth="Infinity" prefHeight="36" minHeight="32"
                        VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>

    </VBox>
</StackPane>

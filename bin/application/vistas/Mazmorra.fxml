<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controlador.MazmorraController"
           stylesheets="@estilos.css"
           styleClass="root-pane">

    <VBox spacing="0">

        <!-- ── Cabecera de fase ── -->
        <HBox styleClass="hud-barra" alignment="CENTER" prefHeight="42">
            <padding><Insets top="0" right="20" bottom="0" left="20"/></padding>
            <Label fx:id="lblFase" styleClass="hud-valor"
                   text="⚔  FASE 1 — MAZMORRA"/>
        </HBox>

        <!-- ── Arena de combate ── -->
        <HBox spacing="0" VBox.vgrow="ALWAYS">

            <!-- Panel héroe -->
            <VBox styleClass="panel-combatiente" alignment="CENTER" spacing="10"
                  prefWidth="230" minWidth="230">
                <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>
                <Label fx:id="lblIconoHeroe" styleClass="icono-combatiente" text="🧙"/>
                <Label fx:id="lblNombreHeroe" styleClass="card-nombre"
                       wrapText="true" textAlignment="CENTER" text="Héroe"/>
                <ProgressBar fx:id="barraVidaHeroe" prefWidth="180" prefHeight="14"
                             progress="1.0" styleClass="barra-vida"/>
                <Label fx:id="lblHpHeroe" styleClass="hud-etiqueta" text="— / — HP"/>
            </VBox>

            <!-- Separador vertical -->
            <Rectangle styleClass="separador-arena" width="1.5" height="400"/>

            <!-- Log central -->
            <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" spacing="10" alignment="TOP_CENTER">
                <padding><Insets top="16" right="16" bottom="10" left="16"/></padding>

                <TextArea fx:id="txtLog"
                          styleClass="log-combate"
                          editable="false"
                          wrapText="true"
                          VBox.vgrow="ALWAYS"/>

                <!-- Label resultado (oculto hasta que termina el combate) -->
                <Label fx:id="lblResultado" styleClass="overlay-titulo-oro"
                       text="" visible="false" alignment="CENTER"
                       VBox.vgrow="NEVER"/>

                <!-- Botones de acción -->
                <HBox alignment="CENTER" spacing="12">
                    <Button fx:id="btnAtacar"
                            styleClass="btn-menu"
                            text="⚔  ATACAR"
                            prefWidth="160" prefHeight="42"
                            onAction="#handleAtacar"/>
                    <Button fx:id="btnHabilidad"
                            styleClass="btn-menu"
                            text="✨ Habilidad"
                            prefWidth="200" prefHeight="42"
                            onAction="#handleHabilidad"/>
                    <Button fx:id="btnGuardarSalir"
                            styleClass="btn-menu-secundario"
                            text="💾  Guardar y Salir"
                            prefWidth="170" prefHeight="42"
                            onAction="#handleGuardarSalir"/>
                </HBox>

                <!-- Botón continuar (oculto hasta fin de combate) -->
                <Button fx:id="btnContinuar"
                        styleClass="btn-menu"
                        text="→  Siguiente Fase"
                        prefWidth="240" prefHeight="44"
                        visible="false"
                        onAction="#handleContinuar"
                        alignment="CENTER"/>

            </VBox>

            <!-- Separador vertical -->
            <Rectangle styleClass="separador-arena" width="1.5" height="400"/>

            <!-- Panel enemigo -->
            <VBox styleClass="panel-combatiente" alignment="CENTER" spacing="10"
                  prefWidth="230" minWidth="230">
                <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>
                <Label fx:id="lblIconoEnemigo" styleClass="icono-combatiente" text="👹"/>
                <Label fx:id="lblNombreEnemigo" styleClass="card-nombre"
                       wrapText="true" textAlignment="CENTER" text="Enemigo"/>
                <ProgressBar fx:id="barraVidaEnemigo" prefWidth="180" prefHeight="14"
                             progress="1.0" styleClass="barra-vida"/>
                <Label fx:id="lblHpEnemigo" styleClass="hud-etiqueta" text="— / — HP"/>
            </VBox>

        </HBox>

    </VBox>
</StackPane>
